[sub_resource type="Shader" id="OceanShader"]
code = "shader_type spatial;
render_mode cull_disabled;
uniform vec3 deep_color = vec3(0.025, 0.18, 0.35);
uniform vec3 shallow_color = vec3(0.02, 0.48, 0.66);
varying float wave_mix;
void vertex(){
 float w1 = sin(VERTEX.x * 0.085 + TIME * 1.25) * 0.20;
 float w2 = cos(VERTEX.z * 0.11 - TIME * 0.95) * 0.13;
 float w3 = sin((VERTEX.x + VERTEX.z) * 0.055 + TIME * 0.7) * 0.08;
 float wave = w1 + w2 + w3;
 VERTEX.y += wave;
 wave_mix = wave;
}
void fragment(){
 float fresnel = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
 float t = clamp(wave_mix * 1.5 + 0.5, 0.0, 1.0);
 ALBEDO = mix(deep_color, shallow_color, t) + vec3(fresnel * 0.12);
 ROUGHNESS = 0.16;
 METALLIC = 0.05;
 SPECULAR = 0.75;
}"

